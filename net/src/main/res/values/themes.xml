<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 独立不透明主题：避免继承宿主 TranslucentTheme / windowDisablePreview，
         也避免与宿主同名 AppTheme 撞车后变成透明窗 + portrait 导致 token 失效。 -->
    <style name="NetPing.Activity" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/theme_color</item>
        <item name="colorPrimaryDark">@color/theme_color</item>
        <item name="colorAccent">@color/theme_color</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 纯白底：首帧未画完时也不易被看成黑屏 -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
